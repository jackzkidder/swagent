<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>SwAgent.AddIn</AssemblyName>
    <RootNamespace>SwAgent.AddIn</RootNamespace>
    <UseWindowsForms>true</UseWindowsForms>

    <!-- This assembly is a COM server. The installer runs regasm /codebase
         against it; we deliberately do NOT set RegisterForComInterop, because
         that would require an elevated build. -->
    <EnableComHosting>false</EnableComHosting>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SwAgent.Core\SwAgent.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Private=TRUE, deliberately, and this is not the usual advice.

         The common guidance is copy-local=false, on the theory that SOLIDWORKS
         loads its own interops and we should bind to whatever it loaded. That
         works at runtime and breaks at REGISTRATION: regasm has to load our
         type to find its ComRegisterFunction, and loading the type means
         resolving ISwAddin from swpublished. regasm is a separate process whose
         probing path is the Framework directory, not ours, and the interops are
         not in the GAC - SOLIDWORKS does not put them there. So regasm fails
         with "Could not load file or assembly SolidWorks.Interop.swpublished"
         and registers nothing at all.

         Copying them is safe. They are strong-named COM interop wrappers, so on
         a seat running this exact version the CLR reuses the already-loaded
         identity. On a NEWER seat our older copy loads alongside theirs and the
         cast to ISldWorks still succeeds, because RCW casts resolve through COM
         QueryInterface on a stable IID rather than through managed type
         identity. That is precisely why compiling against the oldest supported
         interop is the correct strategy. -->
    <Reference Include="SolidWorks.Interop.sldworks">
      <HintPath>$(RepoRefs)SolidWorks.Interop.sldworks.dll</HintPath>
      <EmbedInteropTypes>false</EmbedInteropTypes>
      <Private>true</Private>
    </Reference>
    <Reference Include="SolidWorks.Interop.swconst">
      <HintPath>$(RepoRefs)SolidWorks.Interop.swconst.dll</HintPath>
      <EmbedInteropTypes>false</EmbedInteropTypes>
      <Private>true</Private>
    </Reference>
    <Reference Include="SolidWorks.Interop.swpublished">
      <HintPath>$(RepoRefs)SolidWorks.Interop.swpublished.dll</HintPath>
      <EmbedInteropTypes>false</EmbedInteropTypes>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <!-- Put WebView2Loader.dll beside the assembly.

       PackageReference leaves it under runtimes\win-x64\native, and .NET
       Framework does not probe that folder. More importantly, a native
       P/Invoke resolves against the host EXECUTABLE's directory - SLDWORKS.exe
       in Program Files - not ours, so the file has to be somewhere we can load
       it from by absolute path. See NativeDependencies. -->
  <Target Name="CopyWebView2Loader" AfterTargets="Build">
    <ItemGroup>
      <WebView2Native Include="$(OutDir)runtimes\win-x64\native\WebView2Loader.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(WebView2Native)"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true"
          Condition="Exists('%(WebView2Native.FullPath)')" />
  </Target>

</Project>
